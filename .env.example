# ==========================================
# Configurações do OT Notifier
# ==========================================

# ------------------------------------------
# Configurações de UI (Recomendado manter os padrões)
# ------------------------------------------
# Modo da UI: "live" (dashboard em tempo real) ou "scroll" (logs contínuos)
# O padrão é detectado automaticamente (live se for um terminal interativo)
# UI_MODE=live

# Define se a UI live deve usar a tela alternativa do terminal (fullscreen)
# Padrão: false (imprime progressivamente)
# UI_ALTERNATE_SCREEN=false

# ------------------------------------------
# Webhooks Globais ou Agrupados (Opcional)
# ------------------------------------------
# Um Webhook genérico para todos os servidores sem configuração local ou agrupada.
# WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Você pode usar prefixo agrupado. Exemplo (Aplica a todos que o ID inicia com "global_"):
# WEBHOOK_URL_GLOBAL=https://discord.com/api/webhooks/ID/TOKEN

# ------------------------------------------
# Webhooks Específicos por Servidor (Opcional)
# ------------------------------------------
# Usa o formato WEBHOOK_URL_ + [NOME_DO_SERVIDOR_EM_MAIUSCULAS]
# Exemplo para um servidor salvo no `servers.json` como "id": "meu_servidor":
# WEBHOOK_URL_MEU_SERVIDOR=https://discord.com/api/webhooks/ID/TOKEN

# ------------------------------------------
# Controle Avançado de Scraping & Rate Limits (Padrões geralmente são bons)
# ------------------------------------------

# Concorrência simultânea de requisições de página de personagem
# CONCURRENCY=3

# Tempo de espera (ms) antes de abortar o carregamento da página de guilda
# SERVER_CHECK_TIMEOUT_MS=120000

# Tempo de espera (ms) para resolver contorno de anti-bot (Cloudflare, etc) 
# VERIFY_TIMEOUT_MS=60000

# ------------------------------------------
# Intervalos de Loop (Tempo em ms)
# ------------------------------------------
# Intervalo padrão de checagem do servidor (120000 = 2 minutos)
# CHECK_INTERVAL=120000

# Se o servidor mudar para offline / não responder, espera esse tempo:
# CHECK_INTERVAL_IDLE=900000 

# Se a guild foi apagada ou está completamente limpa:
# CHECK_INTERVAL_EMPTY_GUILD=1800000

# Se estiver sendo protegido ativamente pelo Cloudflare limitando scraping intenso:
# CHECK_INTERVAL_PROTECTED=600000

# ------------------------------------------
# Debugging
# ------------------------------------------
# Define se quer que os erros brutos dos processos em background (workers)
# vazem pro log do orchestrator (Padrão: false)
# SHOW_WORKER_STDERR=false

# ------------------------------------------
# Banco de Dados & Autenticação (Obrigatório para o painel multi-usuário)
# ------------------------------------------
# Setup em um clone novo: rode `pnpm db:migration:run` (tabelas do TypeORM) E
# `pnpm db:auth:migrate` (tabelas do Better Auth: user/session/account/verification),
# nessa ordem — são duas ferramentas independentes contra o mesmo banco, nenhuma
# sabe da existência das migrations da outra.
#
# O cadastro (signup) está aberto para qualquer pessoa. Edição/exclusão de servidor é
# restrita a quem criou (servidores legados sem dono são reivindicados na primeira
# edição). Login/signup/reset de senha têm rate limiting.
#
# Credenciais do Postgres usadas pelo docker-compose.yml (serviço `postgres`) e
# embutidas na DATABASE_URL abaixo — mantenha os dois em sincronia se mudar algum.
POSTGRES_USER=ot_notifier
POSTGRES_PASSWORD=ot_notifier
POSTGRES_DB=ot_notifier

# String de conexão do PostgreSQL usada tanto pelo TypeORM quanto pelo Better Auth.
DATABASE_URL=postgresql://ot_notifier:ot_notifier@localhost:5434/ot_notifier

# Chave secreta usada pelo Better Auth para assinar sessões/tokens.
# Gere uma com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL onde a API (e portanto o Better Auth) está servida — usada para montar os links
# de verificação de email e redefinição de senha enviados por email, que o navegador
# abre direto (sem passar pelo dashboard). No setup padrão (docker compose, nginx
# único) isso é a porta publicada do nginx, já que ele repassa /api/ pro container
# da API, ex: http://localhost:8080. O container da API não publica porta própria
# no host — só use http://localhost:3001 se estiver rodando a API isolada via
# `pnpm api` (sem o nginx na frente).
BETTER_AUTH_URL=http://localhost:8080

# Origem do painel React, usada tanto pelo CORS quanto pelo Better Auth (trustedOrigins).
# No setup padrão (docker compose, nginx único) isso é a porta publicada do nginx, ex: http://localhost:8080.
# Só use http://localhost:5173 se estiver rodando o painel isolado via `pnpm --dir web dev`.
DASHBOARD_URL=http://localhost:8080

# ------------------------------------------
# API e painel em subdomínios separados (Opcional)
# ------------------------------------------
# Só necessário se a API (BETTER_AUTH_URL) e o painel (DASHBOARD_URL) ficarem em
# subdomínios diferentes do mesmo domínio (ex: api.seudominio.com e seudominio.com).
# Deixe tudo isso vazio/comentado se os dois ficarem juntos atrás do mesmo nginx (padrão).

# Domínio do cookie de sessão, compartilhado entre os subdomínios (com o ponto na frente).
# COOKIE_DOMAIN=.seudominio.com

# URL base da API, embutida no build do painel (Vite) para as chamadas de fetch e do
# cliente do Better Auth apontarem pro subdomínio da API em vez de "/api" relativo.
# VITE_API_BASE_URL=https://api.seudominio.com

# Chave da API do Resend (resend.com), usada para enviar o email de recuperação de
# senha. Obrigatória. Em modo sandbox (sem domínio verificado), só entrega pro email
# da própria conta Resend.
RESEND_API_KEY=

# Remetente do email de recuperação de senha. Opcional — usa o sandbox do Resend por
# padrão. Troque por um endereço no seu domínio verificado em resend.com/domains.
# RESEND_FROM_EMAIL=OT Notifier <noreply@seudominio.com>

# Credenciais OAuth do Google (console.cloud.google.com/apis/credentials), para o
# login "Continuar com Google". Opcionais — se ausentes, o botão de Google some/falha
# graciosamente. Cadastre ${BETTER_AUTH_URL}/api/auth/callback/google como redirect URI.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Emails (separados por vírgula) autorizados a acessar o painel Bull-Board
# (/admin/queues) — ele permite pausar/deletar/reprocessar jobs do sistema inteiro,
# não só dos próprios servidores. Sem essa lista, ninguém acessa.
# ADMIN_EMAILS=voce@email.com

# ------------------------------------------
# Proxy para scraping (Opcional)
# ------------------------------------------
# Proxy usado no scraping quando o IP do servidor é bloqueado.
# SCRAPING_PROXY_SERVER=http://host-do-proxy:porta
# SCRAPING_PROXY_USERNAME=
# SCRAPING_PROXY_PASSWORD=

# Resolve desafios do Cloudflare via CapSolver. Exige proxy configurado.
# CAPSOLVER_API_KEY=

# API de extração do provedor, que devolve proxies de IP fixo (um por domínio).
# Costuma exigir o IP do servidor liberado no painel do provedor.
# SCRAPING_PROXY_EXTRACTION_URL=

# Tempo (s) do proxy fixado por domínio e do cache do cf_clearance no Redis.
# PROXY_PIN_TTL_SECONDS=1500
# CF_CLEARANCE_TTL_SECONDS=1500

# ------------------------------------------
# Login em sites de OT que exigem autenticação (Opcional)
# ------------------------------------------
# Chave usada para criptografar (AES-256-GCM) as senhas de login guardadas por
# domínio em site_credentials, permitindo relogin automático quando a sessão cair.
# Obrigatória só se algum servidor cadastrado exigir login. Gere com:
# openssl rand -base64 32
# CREDENTIALS_ENCRYPTION_KEY=
