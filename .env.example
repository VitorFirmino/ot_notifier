# ==========================================
# Configurações do OT Notifier
# ==========================================

# ------------------------------------------
# Configurações de UI (Recomendado manter os padrões)
# ------------------------------------------
# Modo da UI: "live" (dashboard em tempo real) ou "scroll" (logs contínuos)
# O padrão é detectado automaticamente (live se for um terminal interativo)
# UI_MODE=live

# Define se a UI live deve usar a tela alternativa do terminal (fullscreen)
# Padrão: false (imprime progressivamente)
# UI_ALTERNATE_SCREEN=false

# ------------------------------------------
# Webhooks Globais ou Agrupados (Opcional)
# ------------------------------------------
# Um Webhook genérico para todos os servidores sem configuração local ou agrupada.
# WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN

# Você pode usar prefixo agrupado. Exemplo (Aplica a todos que o ID inicia com "global_"):
# WEBHOOK_URL_GLOBAL=https://discord.com/api/webhooks/ID/TOKEN

# ------------------------------------------
# Webhooks Específicos por Servidor (Opcional)
# ------------------------------------------
# Usa o formato WEBHOOK_URL_ + [NOME_DO_SERVIDOR_EM_MAIUSCULAS]
# Exemplo para um servidor salvo no `servers.json` como "id": "meu_servidor":
# WEBHOOK_URL_MEU_SERVIDOR=https://discord.com/api/webhooks/ID/TOKEN

# ------------------------------------------
# Controle Avançado de Scraping & Rate Limits (Padrões geralmente são bons)
# ------------------------------------------

# Concorrência simultânea de requisições de página de personagem
# CONCURRENCY=3

# Tempo de espera (ms) antes de abortar o carregamento da página de guilda
# SERVER_CHECK_TIMEOUT_MS=120000

# Tempo de espera (ms) para resolver contorno de anti-bot (Cloudflare, etc) 
# VERIFY_TIMEOUT_MS=60000

# ------------------------------------------
# Intervalos de Loop (Tempo em ms)
# ------------------------------------------
# Intervalo padrão de checagem do servidor (120000 = 2 minutos)
# CHECK_INTERVAL=120000

# Se o servidor mudar para offline / não responder, espera esse tempo:
# CHECK_INTERVAL_IDLE=900000 

# Se a guild foi apagada ou está completamente limpa:
# CHECK_INTERVAL_EMPTY_GUILD=1800000

# Se estiver sendo protegido ativamente pelo Cloudflare limitando scraping intenso:
# CHECK_INTERVAL_PROTECTED=600000

# ------------------------------------------
# Debugging
# ------------------------------------------
# Define se quer que os erros brutos dos processos em background (workers)
# vazem pro log do orchestrator (Padrão: false)
# SHOW_WORKER_STDERR=false

# ------------------------------------------
# Banco de Dados & Autenticação (Obrigatório para o painel multi-usuário)
# ------------------------------------------
# Setup em um clone novo: rode `pnpm db:migration:run` (tabelas do TypeORM) E
# `pnpm db:auth:migrate` (tabelas do Better Auth: user/session/account/verification),
# nessa ordem — são duas ferramentas independentes contra o mesmo banco, nenhuma
# sabe da existência das migrations da outra.
#
# ATENÇÃO: o cadastro (signup) está aberto para qualquer pessoa. O login/signup tem
# rate limiting (5 tentativas/min em sign-in, 3/min em sign-up), mas ainda não há
# ownership por servidor — qualquer usuário logado pode editar/apagar o servidor de
# qualquer outro. Uso previsto apenas para desenvolvimento local até isso ser
# endereçado — não é seguro expor publicamente como está.
#
# Credenciais do Postgres usadas pelo docker-compose.yml (serviço `postgres`) e
# embutidas na DATABASE_URL abaixo — mantenha os dois em sincronia se mudar algum.
POSTGRES_USER=ot_notifier
POSTGRES_PASSWORD=ot_notifier
POSTGRES_DB=ot_notifier

# String de conexão do PostgreSQL usada tanto pelo TypeORM quanto pelo Better Auth.
DATABASE_URL=postgresql://ot_notifier:ot_notifier@localhost:5434/ot_notifier

# Chave secreta usada pelo Better Auth para assinar sessões/tokens.
# Gere uma com: openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL onde a API (e portanto o Better Auth) está servida. Em desenvolvimento local
# isso é http://localhost:3001, não uma URL pública — ver aviso de segurança acima.
BETTER_AUTH_URL=http://localhost:3001

# Origem do painel React, usada tanto pelo CORS quanto pelo Better Auth (trustedOrigins).
DASHBOARD_URL=http://localhost:5173
